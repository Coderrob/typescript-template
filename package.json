{
  "author": "Your Name",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/YOUR_REPO/issues"
  },
  "dependencies": {
    "pino": "^9.11.0"
  },
  "description": "A production-ready TypeScript project template with comprehensive tooling and best practices.",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "jscpd": "^4.0.5",
    "madge": "^8.0.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.5.0",
    "rollup": "^4.34.6",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Coderrob/typescript-template",
  "keywords": [
    "typescript",
    "template",
    "starter",
    "boilerplate",
    "eslint",
    "prettier",
    "jest",
    "rollup"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.mjs",
  "name": "your-project-name",
  "optionalDependencies": {
    "pino-pretty": "^13.1.1"
  },
  "packageManager": "yarn@4.5.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderrob/typescript-template.git"
  },
  "scripts": {
    "all": "yarn lint:fix && yarn quality && yarn test && yarn package",
    "build": "yarn package",
    "copyright": "sh ./script/copyright ./src",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "duplication": "jscpd src",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "madge": "madge --circular --orphans src",
    "package": "rollup --config rollup.config.js --configPlugin @rollup/plugin-typescript",
    "package:watch": "yarn package --watch",
    "quality": "yarn lint && yarn duplication && yarn madge",
    "start": "node dist/index.mjs",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest && yarn coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}
